{
  "name": "memecoin-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal memecoin starter using Hardhat and OpenZeppelin",
  "scripts": {
    "build": "npm run build:contracts && npm run build:site",
    "build:contracts": "hardhat compile",
    "build:site": "vite build",
    "dev:site": "vite",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "dotenv": "^17.2.1",
    "hardhat": "^2.26.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
